.webhook/

.ruff_cache
.pytest_cache/
.mypy_cache/

.vscode/
.idea/

# VCS, docs, dev tooling, tests
.git/
.github/
.gitignore
.pre-commit-config.yaml
tests/
*.md
api.rest
Makefile
Dockerfile
