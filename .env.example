# NOTE: keep comments on their own lines — never after a value.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME=equitycase-wa-backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080

# ---------------------------------------------------------------------------
# Postgres (docker-compose reads these)
# ---------------------------------------------------------------------------
POSTGRES_USER=equitycase
POSTGRES_PASSWORD=change-me
POSTGRES_DB=equitycase
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://equitycase:change-me@127.0.0.1:5432/equitycase
DB_ECHO=false

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Long random string (min 32 chars):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_HOURS=720

# Dev only. MUST be unset in production (app refuses to start if APP_ENV=production).
# While set, no SMS is sent — leave it empty to test real SMS OTP.
DEV_STATIC_OTP=

# SMS OTP (SMSForYou). All three set = real SMS; the message text is the
# DLT-approved template in src/integrations/sms/sender.py
SMS_API_URL=
SMS_API_KEY=
SENDER_ID=

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API — secrets stay in env, never in the DB
# ---------------------------------------------------------------------------
# Permanent System User token, not a 24h one
META_ACCESS_TOKEN=
# App secret, verifies X-Hub-Signature-256
META_APP_SECRET=
# Your own random string for the webhook GET handshake
META_VERIFY_TOKEN=
# Current version from Meta's changelog
META_API_VERSION=v23.0
# Approved AUTHENTICATION template for OTP delivery
META_OTP_TEMPLATE_NAME=
META_OTP_TEMPLATE_LANG=en

# ---------------------------------------------------------------------------
# Seed inputs (read by `make seed` only)
# ---------------------------------------------------------------------------
BUSINESS_PHONE_NUMBER_ID=
# Optional. Only needed later for listing/using message templates (P11).
BUSINESS_WABA_ID=
# Display form, e.g. +91 22 4000 1234
BUSINESS_DISPLAY_PHONE=
BUSINESS_VERIFIED_NAME=
# Operator login number, E.164 with + — must NOT be the business number
OWNER_PHONE=+91XXXXXXXXXX
OWNER_NAME=You

# ---------------------------------------------------------------------------
# FCM — path to the service-account JSON
# ---------------------------------------------------------------------------
FIREBASE_CREDENTIALS=

# ---------------------------------------------------------------------------
# S3 / Cloudflare R2 media storage
# ---------------------------------------------------------------------------
S3_BUCKET=
# R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL prefix for stored objects
S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Deploy (docker-compose.prod.yml only)
# ---------------------------------------------------------------------------
# Image CI/CD built, e.g. ghcr.io/<org>/equitycase-wa-backend:<git-sha>
APP_IMAGE=
# Host path of the Firebase service-account JSON (mounted read-only)
FIREBASE_CREDENTIALS_FILE=./secrets/fcm-service-account.json
